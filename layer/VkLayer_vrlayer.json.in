{
    "file_format_version": "1.1.2",
    "layer": {
        "name": "@VRLAYER_LAYER_NAME@",
        "type": "GLOBAL",
        "library_path": "@VRLAYER_LAYER_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "VRLayer: streams game frames and depth to the VRLayer OpenXR compositor",
        "enable_environment": {
            "ENABLE_VRLAYER": "1"
        },
        "disable_environment": {
            "DISABLE_VRLAYER": "1"
        }
    }
}
